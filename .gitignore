node_modules
.DS_Store

# Turborepo's local cache
.turbo

.cache
build
database.sqlite

.env
.env.*
# ...except the committed template — the pattern above is broad on purpose
# (catches .env, .env.local, .env.production, etc.) so this has to be a
# separate negation, not folded into it.
!.env.example

# This project uses pnpm — pnpm-lock.yaml is intentionally committed.
# Other package managers' lockfiles stay ignored since we don't use them.
yarn.lock
package-lock.json

extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# vitest --coverage output
coverage

# Playwright e2e output
playwright-report
test-results
blob-report

# React Router's generated route types
.react-router/

# GraphQL codegen output (@shopify/api-codegen-preset, .graphqlrc.ts) —
# regenerated from the live Admin API schema, not checked in.
apps/storebridge/app/types/

# Vercel CLI / build output
.vercel
