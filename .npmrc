engine-strict=true
@shopify:registry=https://registry.npmjs.org

# pnpm isolates each workspace member's dependencies by default (symlinked,
# not flat-hoisted) — the same effect npm's `install-strategy=nested` had to
# be opted into manually. That means shared config packages' plugins (e.g.
# ESLint plugins declared in packages/eslint-config) still don't hoist
# automatically, so every place ESLint actually runs from — apps/storebridge
# (its own `pnpm run lint`) *and* the repo root (husky's pre-commit
# lint-staged, which runs from root) — must also declare them directly. See
# packages/eslint-config/index.cjs.
#
# `vitest` itself still lands in the ROOT node_modules (shared across
# workspaces via its peerDependency in packages/vitest-config), so any
# package vitest dynamically imports at runtime — e.g. `@vitest/coverage-v8`
# (coverage provider) or `jsdom` (test environment) — must also live at the
# root to be resolvable, not just in the app that declares it. Hence those
# are root devDependencies, not apps/storebridge ones.
