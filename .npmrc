engine-strict=true
@shopify:registry=https://registry.npmjs.org

# Default (hoisted) install strategy causes npm's arborist to loop/hang
# resolving this workspace's dependency graph — @shopify/api-codegen-preset's
# deep graphql-codegen chain conflicting with @typescript-eslint/* pulled in
# by a different workspace member (packages/eslint-config). Nested isolates
# each workspace's deps and avoids the cross-workspace backtracking that
# caused it. Tradeoff: shared config packages' plugins (e.g. ESLint plugins
# in packages/eslint-config) no longer hoist automatically, so every place
# ESLint actually runs from — apps/storebridge (its own `npm run lint`) *and*
# the repo root (husky's pre-commit lint-staged, which runs from root) — must
# also declare them directly. See packages/eslint-config/index.cjs.
#
# `vitest` itself still lands in the ROOT node_modules (shared across
# workspaces via its peerDependency in packages/vitest-config), so any
# package vitest dynamically imports at runtime — e.g. `@vitest/coverage-v8`
# (coverage provider) or `jsdom` (test environment) — must also live at the
# root to be resolvable, not just in the app that declares it. Hence those
# are root devDependencies, not apps/storebridge ones.
install-strategy=nested
