# Copy to .env — never commit the real file.

# Supabase Postgres — durable session/offline-token store only (no app data here).
# Use the pooled connection string (pgbouncer) for the app; a direct connection
# is only needed for running `prisma migrate`.
DATABASE_URL=

# Set by `shopify app config link` / CLI — do not hand-edit once linked.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=
