# Copy to .env — never commit the real file.

# Supabase Postgres — durable session/offline-token store, plus StoreBridge's
# own store-pairing/sync-group data (see app/db/schema.server.ts).
# Use the pooled connection string (pgbouncer) for the app; DIRECT_URL (below)
# is only needed for running `drizzle-kit generate`/`migrate`.
DATABASE_URL=

# Supabase's direct/session-mode connection — used only by drizzle-kit for
# migrations, never by the running app.
DIRECT_URL=

# Set by `shopify app config link` / CLI — do not hand-edit once linked.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# Authorizes the background sync worker endpoint (/api/sync-worker): Vercel
# Cron sends it as `Authorization: Bearer <CRON_SECRET>`, and the worker uses
# it to hand a job off to its next run. Any long random string, e.g.
# `openssl rand -hex 32`. Without it, sync jobs only advance while their
# sync page is open. See docs/architecture/definition-sync.md.
CRON_SECRET=
