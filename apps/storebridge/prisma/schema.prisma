// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  // Supabase free-tier Postgres — the durable session/token store (offline
  // access + refresh tokens) *and* StoreBridge's own cross-shop business
  // data (store pairings, sync groups). Shop-local data that Shopify's own
  // admin can represent stays in Shopify metaobjects/metafields instead —
  // but a pairing inherently spans two shops' worth of state (a request
  // pending approval before either side has agreed to trust the other),
  // which can't live as a single shop's metaobject. Set DATABASE_URL to
  // the Supabase connection string (pooled/pgbouncer for serverless,
  // direct for migrations).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// A Shopify shop that has StoreBridge installed. Kept separate from
/// Session (owned by @shopify/shopify-app-session-storage-prisma, holds
/// auth/token state only) — this is where StoreBridge's own business data
/// about a shop anchors.
model Store {
  id        String   @id @default(cuid())
  shop      String   @unique
  name      String?
  createdAt DateTime @default(now())

  sourcedGroups     SyncGroup[]       @relation("SyncGroupSource")
  targetMemberships SyncGroupTarget[] @relation("SyncGroupTargetStore")
}

/// A source store's collection of paired target stores. The store the
/// merchant is currently in when they create a group is always the
/// source — there's no source picker; you can't set a different store as
/// source without being in it.
model SyncGroup {
  id        String   @id @default(cuid())
  name      String?
  sourceId  String
  source    Store    @relation("SyncGroupSource", fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  targets SyncGroupTarget[]
}

enum SyncGroupTargetStatus {
  PENDING
  APPROVED
  DECLINED
}

/// One target store's membership in a sync group — the pairing "invite."
/// Requested from the source side. Shopify has no API to prove two shops
/// share the same owner/organization (confirmed: no such field exists), so
/// approval requires more than just an authenticated session at the
/// target — it requires authTokenHash, a single-use secret the source gets
/// once on request creation and shares out-of-band (email, chat — outside
/// this app) with whoever they trust to actually run the target store.
/// Only someone holding that secret, landing in the target's own
/// authenticated session, can approve. Declining doesn't need it — it's
/// harmless to allow from the dashboard list alone.
model SyncGroupTarget {
  id                 String                @id @default(cuid())
  groupId            String
  group              SyncGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  storeId            String
  store              Store                 @relation("SyncGroupTargetStore", fields: [storeId], references: [id], onDelete: Cascade)
  status             SyncGroupTargetStatus @default(PENDING)
  requestedAt        DateTime              @default(now())
  respondedAt        DateTime?
  /// SHA-256 hash of the raw token — the raw value is shown once, on
  /// request creation, and never stored. Cleared (set back to null) once
  /// used or once approval otherwise no longer needs it.
  authTokenHash      String?               @unique
  authTokenExpiresAt DateTime?

  @@unique([groupId, storeId])
}
